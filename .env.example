# Copia este archivo como .env.local para correr la app en tu compu,
# o pon estas mismas variables en Vercel → Settings → Environment Variables.
# Si las dejas vacías, la app arranca en MODO DEMO (datos de ejemplo, sin login real).

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → anon public (o "publishable key")
# Nunca pongas aquí la llave service_role.
VITE_SUPABASE_ANON_KEY=
